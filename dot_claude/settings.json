  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "i-have-adhd@i-have-adhd": true,
    "superpowers@superpowers-dev": true,
    "mattpocock-skills@mattpocock": true,
    "working-on-llvm@jinpei-skills": true
  },
  "extraKnownMarketplaces": {
