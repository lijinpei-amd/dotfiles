{{ if lookPath "codex" -}}
#!/bin/bash
# Codex reads a Git marketplace only from its snapshot under ~/.codex/.tmp, and
# config.toml alone does not create one; `upgrade` does. Re-runs whenever the
# Codex config template changes. Renders empty until codex is on PATH, so a
# machine where chezmoi runs before Codex is installed gets it on a later apply.
# config template: {{ include "private_dot_codex/modify_private_config.toml" | sha256sum }}
set -euo pipefail
codex plugin marketplace upgrade

# upgrade installs the configured plugins only when the snapshot changes, so add
# any still missing from the cache. `plugin add` also sets enabled = true; put
# back the config chezmoi just wrote, which holds the intended flags.
config="$HOME/.codex/config.toml"
cp -p -- "$config" "$config.chezmoi-orig"
trap 'mv -f -- "$config.chezmoi-orig" "$config"' EXIT
sed -n 's/^\[plugins\."\([^"@]*\)@\(jinpei-skills\|superpowers-dev\|i-have-adhd\)"\]$/\1 \2/p' "$config" |
while read -r plugin marketplace; do
	if [ ! -d "$HOME/.codex/plugins/cache/$marketplace/$plugin" ]; then
		codex plugin add "$plugin@$marketplace"
	fi
done
{{ end -}}
