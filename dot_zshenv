# Non-interactive zsh environment (managed by chezmoi). zsh reads ~/.zshenv on
# EVERY invocation, including non-interactive scripts, so keep this to
# environment only; interactive bits live in ~/.zshrc. Load the repository layer
# first so a fresh install works before the optional private ~/.env.sh exists.
[ -r "$HOME/.env_stow.sh" ] && source "$HOME/.env_stow.sh"
[ -r "$HOME/.env.sh" ] && source "$HOME/.env.sh"
