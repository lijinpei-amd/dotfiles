{{- /* chezmoi:modify-template */ -}}
{{- /*
       .chezmoi.stdin is the current ~/.claude/settings.json; the output
       replaces it. Enforce managed settings while preserving Claude's runtime
       model preferences: managed top-level keys replace the current ones, env is
       merged, and every other key is passed through. A template rather than a
       script so it needs no shell or jq, which Windows lacks. Keys come out
       sorted. */ -}}
{{- $llmProxyBaseUrl := index . "llmProxyBaseUrl" | default "http://127.0.0.1:30101" | trimSuffix "/" -}}
{{- $managed := `{
  "env": {
    "ANTHROPIC_API_KEY": "dummy",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "model": "opus[1m]",
  "disableClaudeAiConnectors": true,
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "i-have-adhd@i-have-adhd": true,
    "superpowers@superpowers-dev": true,
    "mattpocock-skills@mattpocock": true,
    "working-on-llvm@jinpei-skills": true,
    "writing-python-docstrings-and-comments@jinpei-skills": true,
    "amdgpu-isa-builder@jinpei-skills": false,
    "document-skills@anthropic-agent-skills": true
  },
  "extraKnownMarketplaces": {
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    },
    "superpowers-dev": {
      "source": {
        "source": "git",
        "url": "https://github.com/obra/superpowers.git"
      }
    },
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    },
    "jinpei-skills": {
      "source": {
        "source": "github",
        "repo": "lijinpei-amd/skills"
      }
    },
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    }
  },
  "outputStyle": "Concise",
  "effortLevel": "xhigh",
  "tui": "default",
  "skipDangerousModePermissionPrompt": true,
  "preferredNotifChannel": "iterm2"
}` | fromJson -}}
{{- $_ := set $managed.env "ANTHROPIC_BASE_URL" (printf "%s/Anthropic" $llmProxyBaseUrl) -}}
{{- /* Native Windows Claude Code finds Git Bash itself; /bin/bash is not a
       Windows path. */ -}}
{{- if ne .chezmoi.os "windows" -}}
{{-   $_ := set $managed.env "CLAUDE_CODE_SHELL" "/bin/bash" -}}
{{- end -}}
{{- $settings := dict -}}
{{- if trim .chezmoi.stdin -}}
{{-   $settings = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- $env := omit (get $settings "env" | default dict) "ANTHROPIC_CUSTOM_HEADERS" -}}
{{- range $key, $value := $managed -}}
{{-   $_ := set $settings $key $value -}}
{{- end -}}
{{- range $key, $value := $managed.env -}}
{{-   $_ := set $env $key $value -}}
{{- end -}}
{{- $_ := set $settings "env" $env -}}
{{ toPrettyJson $settings -}}
