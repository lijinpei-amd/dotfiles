#!/bin/bash
# Enforce managed settings while preserving Claude's runtime model preferences.
{{ $llmProxyBaseUrl := index . "llmProxyBaseUrl" | default "http://127.0.0.1:30101" | trimSuffix "/" -}}
set -euo pipefail

current=$(cat)
[ -n "$current" ] || current='{}'

managed=$(cat <<'JSON'
{
  "env": {
    "ANTHROPIC_BASE_URL": {{ printf "%s/Anthropic" $llmProxyBaseUrl | toJson }},
    "ANTHROPIC_API_KEY": "dummy",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_SHELL": "/bin/bash"
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "model": "opus[1m]",
  "disableClaudeAiConnectors": true,
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "i-have-adhd@i-have-adhd": true,
    "superpowers@superpowers-dev": true,
    "mattpocock-skills@mattpocock": true,
    "working-on-llvm@jinpei-skills": true,
    "writing-python-docstrings-and-comments@jinpei-skills": true,
    "amdgpu-isa-builder@jinpei-skills": false,
    "document-skills@anthropic-agent-skills": true
  },
  "extraKnownMarketplaces": {
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    },
    "superpowers-dev": {
      "source": {
        "source": "git",
        "url": "https://github.com/obra/superpowers.git"
      }
    },
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    },
    "jinpei-skills": {
      "source": {
        "source": "github",
        "repo": "lijinpei-amd/skills"
      }
    },
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    }
  },
  "outputStyle": "Concise",
  "effortLevel": "xhigh",
  "tui": "default",
  "skipDangerousModePermissionPrompt": true,
  "preferredNotifChannel": "iterm2"
}
JSON
)

printf '%s\n' "$(printf '%s' "$current" |
    jq --argjson managed "$managed" '. as $current | . + $managed | .env = (($current.env // {} | del(.ANTHROPIC_CUSTOM_HEADERS)) + $managed.env)')"
