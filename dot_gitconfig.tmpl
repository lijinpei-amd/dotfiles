{{/* The identity is per machine with no default: an unset key is left out, so
     git asks for it, or an included file below supplies it. */ -}}
{{ $name := index . "gitName" -}}
{{ $email := index . "gitEmail" -}}
{{ if or $name $email -}}
[user]
{{- with $name }}
	name = {{ . }}
{{- end }}
{{- with $email }}
	email = {{ . }}
{{- end }}
{{ end -}}
[core]
	excludesfile = {{ .chezmoi.homeDir }}/.gitignore
[init]
	defaultBranch = main
{{ if lookPath "git-lfs" -}}
{{/* Written into ~/.gitconfig by `git lfs install`. Guarded rather than
     unconditional because required = true makes git fail outright on any LFS
     repo when the binary is missing, so machines without git-lfs must not get
     it. Installing git-lfs later is enough for the next apply to add it. */ -}}
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
{{ end -}}
{{/* Per-machine conditional includes, such as a work identity for repos whose
     remote goes through a dedicated SSH host alias. Kept last so that what an
     included file sets overrides [user] above. */ -}}
{{ range $condition, $path := index . "gitIncludeIf" | default dict -}}
[includeIf "{{ $condition }}"]
	path = {{ $path }}
{{ end -}}
