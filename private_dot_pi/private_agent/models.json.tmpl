{{ $llmProxyBaseUrl := .llmProxyBaseUrl | trimSuffix "/" -}}
{
  "providers": {
    "amd-openai": {
      "baseUrl": "{{ $llmProxyBaseUrl }}/OpenAI/",
      "api": "openai-completions",
      "discoverModels": true,
      "apiKey": "dummy",
      "modelApi": {
        "codex": "openai-responses",
        "^gpt-(5\\.6|6)": "openai-responses"
      },
      "metadataUrl": "https://models.dev/api.json",
      "metadataProvider": "openai"
    },
    "amd-openai-dvue": {
      "baseUrl": "{{ $llmProxyBaseUrl }}/OpenAI-dvue/",
      "api": "openai-completions",
      "discoverModels": true,
      "metadataUrl": "https://models.dev/api.json",
      "metadataProvider": "openai",
      "apiKey": "dummy",
      "modelApi": {
        "codex": "openai-responses",
        "^gpt-(5\\.6|6)": "openai-responses"
      }
    },
    "amd-openai-pdue": {
      "baseUrl": "{{ $llmProxyBaseUrl }}/OpenAI-pdue/",
      "api": "openai-completions",
      "discoverModels": true,
      "metadataUrl": "https://models.dev/api.json",
      "metadataProvider": "openai",
      "apiKey": "dummy",
      "modelApi": {
        "codex": "openai-responses",
        "^gpt-(5\\.6|6)": "openai-responses"
      }
    },
    "amd-anthropic": {
      "baseUrl": "{{ $llmProxyBaseUrl }}/Anthropic/",
      "api": "anthropic-messages",
      "discoverModels": true,
      "modelsUrl": "{{ $llmProxyBaseUrl }}/OpenAI/models",
      "modelIdRegex": "^Claude-",
      "metadataUrl": "https://models.dev/api.json",
      "metadataProvider": "anthropic",
      "apiKey": "dummy"
    }
  }
}
