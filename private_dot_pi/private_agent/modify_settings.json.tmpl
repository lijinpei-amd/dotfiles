#!/bin/bash
# chezmoi modify_ script: stdin is the current ~/.pi/agent/settings.json, stdout
# replaces it. pi rewrites this file at runtime -- defaultProvider and
# defaultModel whenever the model is switched, lastChangelogVersion on startup,
# anything changed through /settings -- so the managed keys below are enforced,
# the default model is only seeded where none is set yet, and every other key is
# passed through untouched.
#
# The output matches pi's own JSON.stringify(settings, null, 2): two-space
# indent, no trailing newline. Keep Go template delimiters out of the jq.
set -euo pipefail

current=$(cat)
[ -n "$current" ] || current='{}'

seed='{
  "defaultProvider": "amd-anthropic",
  "defaultModel": "Claude-Opus-5"
}'

# jinpei-skills arrives as a package, which pi clones on first use; "skills" is
# emptied so an older local-clone path cannot load the same skill twice.
managed='{
  "enabledModels": ["amd-anthropic/*", "amd-openai/*"],
  "packages": [
    "https://github.com/ayghri/i-have-adhd",
    "git:github.com/DietrichGebert/ponytail",
    "npm:pi-subagents",
    "git:github.com/lijinpei-amd/skills"
  ],
  "theme": "dark",
  "skills": []
}'

printf '%s' "$(printf '%s' "$current" |
	jq --argjson seed "$seed" --argjson managed "$managed" '$seed + . + $managed')"
