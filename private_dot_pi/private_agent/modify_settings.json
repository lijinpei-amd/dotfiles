{{- /* chezmoi:modify-template */ -}}
{{- /*
       .chezmoi.stdin is the current ~/.pi/agent/settings.json; the output
       replaces it. pi rewrites this file at runtime -- defaultProvider and
       defaultModel whenever the model is switched, lastChangelogVersion on
       startup, anything changed through /settings -- so the managed keys below
       are enforced, the default model is only seeded where none is set yet, and
       every other key is passed through untouched. A template rather than a
       script so it needs no shell or jq, which Windows lacks.

       The output matches pi's own JSON.stringify(settings, null, 2): two-space
       indent, no trailing newline. Keys come out sorted. */ -}}
{{- $seed := dict "defaultProvider" "amd-openai-dvue" "defaultModel" "gpt-6.1-sol" -}}
{{- /* jinpei-skills arrives as a package, which pi clones on first use;
       "skills" is emptied so an older local-clone path cannot load the same
       skill twice. */ -}}
