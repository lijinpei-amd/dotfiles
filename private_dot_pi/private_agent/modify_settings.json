{{- if index . "deepseekApiKey" | default "" | trim -}}
{{-   $enabledModels := list "deepseek/*" -}}
{{-   if index . "llmProxyBaseUrl" | default "" | trim -}}
{{-     $enabledModels = append (get $managed "enabledModels") "deepseek/*" -}}
{{-   end -}}
{{-   $_ := set $managed "enabledModels" $enabledModels -}}
{{- end -}}
{{- $current := dict -}}
{{- if trim .chezmoi.stdin -}}
{{-   $current = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- $settings := $seed -}}
{{- range $key, $value := $current -}}
{{-   $_ := set $settings $key $value -}}
{{- end -}}
{{- range $key, $value := $managed -}}
{{-   $_ := set $settings $key $value -}}
{{- end -}}
{{ toPrettyJson $settings | trimSuffix "\n" -}}
