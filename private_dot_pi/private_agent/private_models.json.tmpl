{{ $llmProxyBaseUrl := index . "llmProxyBaseUrl" | default "" | trim | trimSuffix "/" -}}
{{ $deepseekApiKey := index . "deepseekApiKey" | default "" | trim -}}
{
  "providers": {
{{- if $llmProxyBaseUrl }}
    "amd-openai": {
      "modelIdRegex": "^gpt-(5\\.6|6(?:\\.[0-9]+)?)(?:-|$)",
      "baseUrl": "{{ $llmProxyBaseUrl }}/OpenAI/",
      "api": "openai-completions",
      "discoverModels": true,
      "apiKey": "dummy",
      "modelApi": {
        "codex": "openai-responses",
        "^gpt-(5\\.6|6)": "openai-responses"
      },
      "metadataUrl": "https://models.dev/api.json",
      "metadataProvider": "openai"
    },
    "amd-openai-dvue": {
      "modelIdRegex": "^gpt-(5\\.6|6(?:\\.[0-9]+)?)(?:-|$)",
      "baseUrl": "{{ $llmProxyBaseUrl }}/OpenAI-dvue/",
      "api": "openai-completions",
      "discoverModels": true,
      "metadataUrl": "https://models.dev/api.json",
      "metadataProvider": "openai",
      "apiKey": "dummy",
      "modelApi": {
        "codex": "openai-responses",
        "^gpt-(5\\.6|6)": "openai-responses"
      }
    },
    "amd-openai-pdue": {
      "modelIdRegex": "^gpt-(5\\.6|6(?:\\.[0-9]+)?)(?:-|$)",
      "baseUrl": "{{ $llmProxyBaseUrl }}/OpenAI-pdue/",
      "api": "openai-completions",
      "discoverModels": true,
      "metadataUrl": "https://models.dev/api.json",
      "metadataProvider": "openai",
      "apiKey": "dummy",
      "modelApi": {
        "codex": "openai-responses",
        "^gpt-(5\\.6|6)": "openai-responses"
      }
    },
    "amd-anthropic": {
      "baseUrl": "{{ $llmProxyBaseUrl }}/Anthropic/",
      "api": "anthropic-messages",
      "discoverModels": true,
      "modelsUrl": "{{ $llmProxyBaseUrl }}/OpenAI/models",
      "modelIdRegex": "^Claude-(Opus|Sonnet|Haiku)-5(?:\\.5)?(?:-|$)",
      "metadataUrl": "https://models.dev/api.json",
      "metadataProvider": "anthropic",
      "apiKey": "dummy"
    }
{{- end }}
{{- if $deepseekApiKey }}
{{- if $llmProxyBaseUrl }},{{ end }}
    "deepseek": {
      "baseUrl": "https://api.deepseek.com",
      "api": "openai-completions",
      "apiKey": {{ $deepseekApiKey | toJson }}
    }
{{- end }}
  }
}
